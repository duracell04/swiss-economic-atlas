---
import Layout from '../../layouts/Layout.astro';
import { registry, href, manifest, topics } from '../../lib/catalogue';
import { unemploymentMethod, unemploymentComparison } from '../../lib/unemployment';
import { exchangeRateNote } from '../../lib/exchange-rates';
import { labourInputNote } from '../../lib/labour-input';
export function getStaticPaths() { return registry.series.map(series => ({ params: { id: series.id }, props: { series } })); }
const { series } = Astro.props;
const sources = registry.sources.filter(s => series.source_ids.includes(s.id));
const topic = topics.find(t => t.series_ids.includes(series.id));
const dataset = manifest.datasets.find(d => d.id === series.id);
const sixLicensedSeries = new Set(['smi', 'smic', 'smi-annual-return', 'smic-annual-return']);
const requiresSixLicence = sixLicensedSeries.has(series.id);
const labour = unemploymentMethod(series.id);
const fxNote = exchangeRateNote(series.id);
const inputNote = labourInputNote(series.id);
const noBreaks = inputNote ? 'FSO harmonised pre-2010 hours to preserve continuity; see the source-adjustment notes. No artificial 2010 gap is introduced.' : 'Audit pending; an empty register does not establish continuity.';
---
<Layout title={series.title} description={series.definition}>
  <section class="page-heading"><a class="back-link" href={href(`series/${topic ? `#topic-${topic.id}` : ""}`)}>← Series catalogue</a><div class="eyebrow">SERIES / {series.id}</div><h1 class="detail-title">{series.title}</h1><p>{series.definition}</p></section>
  <aside class="notice"><span class="status-dot" aria-hidden="true"></span><div><strong>{series.data_class === 'synthetic' ? 'Synthetic demonstration — not Swiss historical observations' : series.verification === 'candidate' ? 'Awaiting source verification' : 'Definition verified'}</strong><p>{dataset ? `${dataset.observation_count} observations available.` : 'No public observations. Historical coverage has not been established for publication.'}</p></div></aside>
  {fxNote && <section class="details"><h2>How to read this exchange rate</h2><p>{fxNote}</p><a href={href('methodology/#exchange-rates')}>Exchange-rate sources and annual methods →</a></section>}
  {inputNote && <section class="details"><h2>Productivity and compatible hours</h2><p>{inputNote}</p><p>The FSO adapted pre-2010 hours to preserve continuity. This is a documented source adjustment, not a new break or interpolation by the atlas. Available annual periods: 1991–2025.</p><a href={href('methodology/#productivity-hours')}>Productivity and hours: definitions and sources →</a></section>}
  {labour && <section class="details"><h2>How this unemployment rate is measured</h2><p>{labour.definition}</p><dl><dt>Source</dt><dd>{labour.source}</dd><dt>Method</dt><dd>{labour.method}</dd><dt>Available periods</dt><dd>{dataset ? `${dataset.coverage.first}–${dataset.coverage.last}` : 'No public observations'}</dd><dt>Aggregation</dt><dd>{series.aggregation}</dd></dl><p class="muted">{unemploymentComparison}</p><a href={href('methodology/#unemployment')}>Definitions and annual methods →</a> · <a href={labour.reference.url}>{labour.reference.title} ↗</a></section>}
  {requiresSixLicence && <section class="license-placeholder" aria-labelledby="license-placeholder-title"><div class="eyebrow">CHART STATUS</div><h2 id="license-placeholder-title">Chart awaiting SIX licensing</h2><p>This chart is reserved for the {series.title}. We will display the historical observations here once SIX confirms permission for the atlas to use and redistribute the data.</p><p class="license-links"><a class="button" href="https://www.six-group.com/en/market-data/indices/licensing.html" target="_blank" rel="noreferrer">Request SIX licensing ↗</a> <a href="https://www.six-group.com/en/market-data/indices/switzerland/equity/smi.html" target="_blank" rel="noreferrer">View SMI / SMIC at SIX ↗</a></p></section>}
  <section class="details"><h2>Statistical identity</h2><dl><dt>Unit</dt><dd>{series.unit.label}</dd><dt>Native frequency</dt><dd>{series.frequency}</dd><dt>Institutional coverage</dt><dd>{series.institutional_coverage}</dd><dt>Instrument</dt><dd>{series.instrument ?? 'Not applicable'}</dd><dt>Maturity</dt><dd>{series.maturity ?? 'Not applicable'}</dd><dt>Aggregation convention</dt><dd>{series.aggregation}</dd><dt>Historical breaks</dt><dd>{series.breaks.length ? series.breaks.map(b => `${b.period}: ${b.description}`).join('; ') : noBreaks}</dd><dt>Usage</dt><dd>{series.usage_notes}</dd></dl></section>
  <section class="details"><h2>Source starting points</h2><div class="source-grid">{sources.map(source => <article><div class="eyebrow">{source.audit_status}</div><h3>{source.publisher}</h3><p>{source.definition}</p><p>Redistribution: <strong>{source.rights.redistribution}</strong></p><a href={source.data_url ?? source.landing_url}>Visit source ↗</a></article>)}</div><p class="muted">Landing pages are audit starting points. Exact dataset identifiers and rights evidence are required before publication.</p></section>
  {dataset && <section class="details"><h2>Download observations</h2><a class="button" href={href(`data/${dataset.files.csv}`)} download>CSV ↓</a> <a href={href(`data/${dataset.files.json}`)} download>JSON ↓</a></section>}
</Layout>
