# Auto detect text files and perform LF normalization
* text=auto

# Immutable source snapshots retain publisher bytes and checksum on every platform.
data/raw/** -text

# Preserve exact publisher bytes for reproducible workbook/CSV extractions.
data/extractions/originals/** -text

# Checked extraction inputs are also checksum-pinned; preserve their exact bytes.
data/extractions/checked/** -text
